# Server Configuration
PORT=3001
NODE_ENV=development

# SQLite Database Configuration
# Database file will be created in the data/ directory
# This is a relative path from the project root
DB_FILE=./data/billflow.sqlite


# JWT Configuration
# Must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-and-make-it-long
JWT_EXPIRES_IN=24h

# CORS Configuration
# Comma separated list, use * only for local testing
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

